{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/login",
      "destination": "https://accounts.mhentuniverse.com/login",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "https://accounts.mhentuniverse.com/login",
      "permanent": false
    },
    {
      "source": "/profile",
      "destination": "https://accounts.mhentuniverse.com/profile",
      "permanent": false
    },
    {
      "source": "/profile.html",
      "destination": "https://accounts.mhentuniverse.com/profile",
      "permanent": false
    },
    {
      "source": "/setting",
      "destination": "https://accounts.mhentuniverse.com/profile",
      "permanent": false
    },
    {
      "source": "/settings",
      "destination": "https://accounts.mhentuniverse.com/profile",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://mhentuniverse.firebaseapp.com/__/auth/:path*"
    }
  ]
}