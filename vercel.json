{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/login",
      "destination": "https://accounts.mhentuniverse.com/login",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "https://accounts.mhentuniverse.com/login",
      "permanent": false
    },
    {
      "source": "/profile",
      "destination": "https://accounts.mhentuniverse.com/profile",
      "permanent": false
    },
    {
      "source": "/profile.html",
      "destination": "https://accounts.mhentuniverse.com/profile",
      "permanent": false
    },
    {
      "source": "/setting",
      "destination": "https://accounts.mhentuniverse.com/profile",
      "permanent": false
    },
    {
      "source": "/settings",
      "destination": "https://accounts.mhentuniverse.com/profile",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://mhentuniverse.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "apps.mhentuniverse.com"
        }
      ],
      "destination": "/apps/index.html"
    },
    {
      "source": "/horizon",
      "has": [
        {
          "type": "host",
          "value": "apps.mhentuniverse.com"
        }
      ],
      "destination": "/apps/horizon.html"
    },
    {
      "source": "/orbit",
      "has": [
        {
          "type": "host",
          "value": "apps.mhentuniverse.com"
        }
      ],
      "destination": "/apps/orbit.html"
    },
    {
      "source": "/aisa-horizon",
      "has": [
        {
          "type": "host",
          "value": "apps.mhentuniverse.com"
        }
      ],
      "destination": "/apps/horizon.html"
    },
    {
      "source": "/aisa-orbit",
      "has": [
        {
          "type": "host",
          "value": "apps.mhentuniverse.com"
        }
      ],
      "destination": "/apps/orbit.html"
    },
    {
      "source": "/assets/:path*",
      "has": [
        {
          "type": "host",
          "value": "apps.mhentuniverse.com"
        }
      ],
      "destination": "/apps/assets/:path*"
    },
    {
      "source": "/css/:path*",
      "has": [
        {
          "type": "host",
          "value": "apps.mhentuniverse.com"
        }
      ],
      "destination": "/apps/css/:path*"
    },
    {
      "source": "/js/:path*",
      "has": [
        {
          "type": "host",
          "value": "apps.mhentuniverse.com"
        }
      ],
      "destination": "/apps/js/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "apps.mhentuniverse.com"
        }
      ],
      "destination": "/apps/:path*"
    },
    {
      "source": "/horizon",
      "destination": "/apps/horizon.html"
    },
    {
      "source": "/orbit",
      "destination": "/apps/orbit.html"
    },
    {
      "source": "/aisa-horizon",
      "destination": "/apps/horizon.html"
    },
    {
      "source": "/aisa-orbit",
      "destination": "/apps/orbit.html"
    },
    {
      "source": "/music",
      "destination": "/music/index.html"
    },
    {
      "source": "/music/",
      "destination": "/music/index.html"
    }
  ]
}