rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserEmail() {
      return request.auth.token.email != null ? request.auth.token.email : '';
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserEmail() in ['mhent@mhentuniverse.com', 'contact@mhentuniverse.com', 'miyazakiharuto.ent.co@gmail.com', 'tokugawasakura58@gmail.com'] ||
        getUserEmail().matches('(?i).*@mhentuniverse\\.com$') ||
        getUserEmail().matches('(?i).*admin.*') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('(?i).*(admin|root|boss|chủ tịch).*'))
      );
    }

    function isSessionOwner(data) {
      return isAuthenticated() && (
        // Khớp UID người tạo
        ('createdByUid' in data && data.createdByUid is string && data.createdByUid != '' && request.auth.uid == data.createdByUid) ||
        // Khớp Email người tạo (không phân biệt hoa thường)
        ('createdByEmail' in data && data.createdByEmail is string && data.createdByEmail != '' && getUserEmail() != '' && getUserEmail().matches('(?i)^' + data.createdByEmail + '$'))
      );
    }

    // 1. NGƯỜI DÙNG (users)
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 2. BIỂU MẪU (mhent_forms)
    match /mhent_forms/{formId} {
      allow read, write: if true;
    }

    // 3. CÂU TRẢ LỜI BIỂU MẪU (mhent_form_responses)
    match /mhent_form_responses/{responseId} {
      // Cho phép mọi người nộp bài và cho phép bảng tính Sheet đọc/sửa/xóa câu trả lời
      allow read, write: if true;
    }

    // 4. PHIM & RẠP PHIM (movies, pending_movies, reports)
    match /movies/{movieId} {
      allow read, write: if true;
    }
    match /pending_movies/{movieId} {
      allow read, write: if true;
    }
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // 5. NHẬT KÝ, CHIẾN DỊCH MAIL & HỆ THỐNG (logs, mail_campaigns, system, system_settings)
    match /logs/{logId} {
      allow read, write: if true;
    }
    match /mail_campaigns/{campaignId} {
      allow read, write: if true;
    }
    match /system/{docId} {
      allow read, write: if true;
    }
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. ĐIỂM DANH & CHECK-IN (mhent_checkin_sessions, mhent_checkin_logs)
    match /mhent_checkin_sessions/{sessionId} {
      // Cho phép đọc, tạo, cập nhật, xóa (phân quyền chỉ Admin & Chủ tạo phiên xóa được kiểm soát chặt chẽ tại tầng giao diện/ứng dụng SSO)
      allow read, write: if true;
    }
    match /mhent_checkin_logs/{logId} {
      allow read, write: if true;
    }

    // 7. CỔNG LIÊN KẾT RÚT GỌN THÔNG MINH (mhent_links - MHEnt Gateway / SmartLinks)
    match /mhent_links/{linkId} {
      allow read, write: if true;
    }
  }
}
